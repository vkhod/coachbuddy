{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cocoach.vkhod.dev/schema/plan.schema.json",
  "title": "Plan",
  "description": "One class plan. Sections are absent until their agent has finished; sectionStatus says why.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "planId",
    "coachId",
    "revision",
    "input",
    "sectionStatus"
  ],
  "properties": {
    "planId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "coachId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "input": {
      "$ref": "#/$defs/ClassInput"
    },
    "today": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/TodayGroup"
      }
    },
    "wod": {
      "$ref": "#/$defs/Wod"
    },
    "warmup": {
      "$ref": "#/$defs/Warmup"
    },
    "parts": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/PartScaling"
      }
    },
    "injuries": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/Injury"
      }
    },
    "timeline": {
      "$ref": "#/$defs/Timeline"
    },
    "sectionStatus": {
      "$ref": "#/$defs/SectionStatusMap"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "TierKey": {
      "type": "string",
      "enum": [
        "rx",
        "rxPlus",
        "scaled",
        "senior"
      ]
    },
    "ClassInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "imageRef",
        "classMinutes"
      ],
      "properties": {
        "imageRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "comment": {
          "type": "string",
          "maxLength": 1000
        },
        "classMinutes": {
          "type": "integer",
          "minimum": 20,
          "maximum": 180
        }
      }
    },
    "TodayGroup": {
      "description": "Who attends today, read from the comment. Highlights the matching tier row.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "tier",
        "fromComment"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "tier": {
          "$ref": "#/$defs/TierKey"
        },
        "fromComment": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "Wod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "parts"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "date": {
          "type": "string",
          "description": "WOD date as YYYY-MM-DD.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/WodPart"
          }
        }
      }
    },
    "WodPart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "prescription",
        "minutes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/PartId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "kind": {
          "$ref": "#/$defs/PartKind"
        },
        "prescription": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        }
      }
    },
    "Warmup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minutes",
        "targets",
        "blocks"
      ],
      "properties": {
        "minutes": {
          "type": "integer",
          "minimum": 3,
          "maximum": 30
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/WarmupTarget"
          }
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/WarmupBlock"
          }
        }
      }
    },
    "WarmupTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "area",
        "why"
      ],
      "properties": {
        "area": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "WarmupBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "minutes",
        "items"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      }
    },
    "PartScaling": {
      "description": "Tiers, cues and detail for one WOD part. layout 'grid' is for conditioning parts with up to five movements.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partId",
        "layout",
        "tiers",
        "cues"
      ],
      "properties": {
        "partId": {
          "$ref": "#/$defs/PartId"
        },
        "layout": {
          "$ref": "#/$defs/PartLayout"
        },
        "columns": {
          "description": "Grid only. One column per movement or minute, in class order.",
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          }
        },
        "tiers": {
          "$ref": "#/$defs/Tiers"
        },
        "cues": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "more": {
          "$ref": "#/$defs/PartMore"
        }
      }
    },
    "Tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rx",
        "scaled",
        "senior"
      ],
      "properties": {
        "rx": {
          "$ref": "#/$defs/Tier"
        },
        "rxPlus": {
          "$ref": "#/$defs/Tier"
        },
        "scaled": {
          "$ref": "#/$defs/Tier"
        },
        "senior": {
          "$ref": "#/$defs/Tier"
        }
      }
    },
    "Tier": {
      "description": "line is always present (list view, share view). cells only in grid parts, one per column, same order.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line"
      ],
      "properties": {
        "line": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "cells": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        }
      }
    },
    "PartMore": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "substitutions": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "faults": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/Fault"
          }
        }
      }
    },
    "Fault": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fault",
        "fix"
      ],
      "properties": {
        "fault": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "fix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "Injury": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "fromComment",
        "warmup",
        "parts",
        "caution"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "fromComment": {
          "type": "string",
          "maxLength": 200
        },
        "returnNote": {
          "type": "string",
          "maxLength": 60
        },
        "warmup": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "parts": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/InjuryPart"
          }
        },
        "caution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "InjuryPart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partId",
        "suggestion"
      ],
      "properties": {
        "partId": {
          "$ref": "#/$defs/PartId"
        },
        "suggestion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "Timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalMinutes",
        "blocks",
        "status",
        "provisional"
      ],
      "properties": {
        "totalMinutes": {
          "type": "integer",
          "minimum": 20,
          "maximum": 180
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 15,
          "items": {
            "$ref": "#/$defs/TimelineBlock"
          }
        },
        "status": {
          "$ref": "#/$defs/TimelineStatus"
        },
        "warnings": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "provisional": {
          "type": "boolean",
          "description": "True while the warm-up section is missing or failed."
        }
      }
    },
    "TimelineBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startMin",
        "endMin",
        "label"
      ],
      "properties": {
        "startMin": {
          "type": "integer",
          "minimum": 0
        },
        "endMin": {
          "type": "integer",
          "minimum": 1
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "section": {
          "type": "string",
          "description": "Jump target: 'warmup' or a part id.",
          "pattern": "^(warmup|brief|transition|[A-Z][0-9]?)$"
        }
      }
    },
    "SectionState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/SectionStateName"
        },
        "error": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "SectionStatusMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wod",
        "warmup",
        "parts",
        "injuries",
        "timeline"
      ],
      "properties": {
        "wod": {
          "$ref": "#/$defs/SectionState"
        },
        "warmup": {
          "$ref": "#/$defs/SectionState"
        },
        "parts": {
          "$ref": "#/$defs/SectionState"
        },
        "injuries": {
          "$ref": "#/$defs/SectionState"
        },
        "timeline": {
          "$ref": "#/$defs/SectionState"
        }
      }
    },
    "PartKind": {
      "type": "string",
      "enum": [
        "strength",
        "skill",
        "core",
        "conditioning"
      ]
    },
    "PartLayout": {
      "type": "string",
      "enum": [
        "lines",
        "grid"
      ]
    },
    "TimelineStatus": {
      "type": "string",
      "enum": [
        "OPTIMAL",
        "TIGHT",
        "INVALID"
      ]
    },
    "SectionStateName": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "done",
        "failed",
        "skipped"
      ]
    },
    "PartId": {
      "type": "string",
      "description": "WOD part id as on the board: A, B, C or A1, A2.",
      "pattern": "^[A-Z][0-9]?$"
    }
  }
}
