#!/usr/bin/env bash
# Generates the contract types for every service from schema/*.schema.json.
# The generated files are committed; CI runs this script and fails if anything changes.
#
# Tool versions are pinned here because they change the output:
#   TypeScript  json-schema-to-typescript 16.0.0   (schema/package.json, npm ci in schema/)
#   Python      datamodel-code-generator 0.97.0, ruff 0.16.9   (schema/requirements-gen.txt)
#   Go          go-jsonschema v0.24.1               (go run, needs Go 1.27)
#   Rust        cargo-typify 0.10.1, rustfmt from Rust 1.97
set -euo pipefail

GO_JSONSCHEMA=github.com/atombender/go-jsonschema@v0.24.1
TYPIFY_VERSION=0.10.1

root="$(cd "$(dirname "$0")/.." && pwd)"
schema="$root/schema"
cd "$schema"

need() { command -v "$1" >/dev/null || { echo "gen-schema: $1 not found. $2" >&2; exit 1; }; }
need node "Install Node 22."
need datamodel-codegen "pip install -r schema/requirements-gen.txt"
need go "Install Go 1.27."
need cargo "Install Rust 1.97."
[ -d "$schema/node_modules/json-schema-to-typescript" ] || { echo "gen-schema: run 'npm ci' in schema/ first." >&2; exit 1; }
typify_found="$(cargo typify --version 2>/dev/null || true)"
[ "$typify_found" = "cargo-typify $TYPIFY_VERSION" ] || { echo "gen-schema: need cargo-typify $TYPIFY_VERSION (found '${typify_found:-none}'). cargo install cargo-typify --version $TYPIFY_VERSION --locked" >&2; exit 1; }
datamodel_found="$(datamodel-codegen --version)"
[ "$datamodel_found" = "datamodel-codegen 0.97.0" ] || { echo "gen-schema: need datamodel-codegen 0.97.0 (found '$datamodel_found'). pip install -r schema/requirements-gen.txt" >&2; exit 1; }

banner="Generated by scripts/gen-schema from schema/. Do not edit; change the schema and run scripts/gen-schema."
api_schemas=(plan create-plan.request regenerate-section.request plan-event plan-revision)

# TypeScript: one module per schema.
ts_out="$root/web/pwa-nextjs/src/lib/contract"
rm -rf "$ts_out" && mkdir -p "$ts_out"
for s in "${api_schemas[@]}"; do
  npx --no-install json2ts -i "$s.schema.json" -o "$ts_out/$s.ts" \
    --additionalProperties false --maxItems -1 --bannerComment "/* $banner */"
done

# Python (Pydantic v2): one module per schema.
py_out="$root/services/agents-python/app/contract"
mkdir -p "$py_out"
find "$py_out" -maxdepth 1 -name '*.py' ! -name 'rules.py' -delete
for s in "${api_schemas[@]}"; do
  module="${s//[.-]/_}"
  datamodel-codegen --input "$s.schema.json" --input-file-type jsonschema \
    --output "$py_out/$module.py" --output-model-type pydantic_v2.BaseModel \
    --target-python-version 3.12 --disable-timestamp --use-double-quotes \
    --collapse-root-models --formatters ruff-format \
    --custom-file-header "# $banner" 2>/dev/null
done
printf '# %s\n' "$banner" > "$py_out/__init__.py"

# Go: one file for the gateway.
go_out="$root/services/gateway-go/internal/contract"
mkdir -p "$go_out"
args=()
for s in "${api_schemas[@]}"; do args+=("$s.schema.json"); done
go run "$GO_JSONSCHEMA" -p contract -t --tags json -o "$go_out/contract.go" "${args[@]}"
gofmt -w "$go_out/contract.go"

# Rust: the MCP tool inputs and outputs only (mcp-rust never handles a plan).
rs_out="$root/services/mcp-rust/src/contract.rs"
tmp="$(mktemp)"
cargo typify --no-builder tools.schema.json -o "$tmp"
{ printf '// %s\n\n' "$banner"; cat "$tmp"; } > "$rs_out"
rm -f "$tmp"
rustfmt --edition 2021 "$rs_out"

echo "gen-schema: done"
