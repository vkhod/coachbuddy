# ============================================================================
# CoachBuddy Polyglot Microservices Configuration
# ============================================================================

# --- Security & Cryptography (Go Gateway) ---
JWT_SECRET=coachbuddy-super-secret-jwt-signing-key-2026
# 32-byte (64 hex chars) Master Key Encryption Key (KEK) for AES-256-GCM BYOK Vault
MASTER_ENCRYPTION_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Databases ---
POSTGRES_DSN=postgres://coachbuddy:coachbuddy_secret@localhost:5432/coachbuddy?sslmode=disable
MONGO_URI=mongodb://localhost:27017
MONGO_DB=coachbuddy
REDIS_URL=redis://localhost:6379/0

# --- Service Discovery URLs ---
GATEWAY_PORT=8080
AGENTS_SERVICE_URL=http://localhost:8081
MCP_RUST_URL=http://localhost:8082
PUBLIC_SHARE_BASE_URL=http://localhost:3000/s

# --- Optional System Fallback LLM Key (if Coach hasn't configured BYOK yet) ---
DEFAULT_GEMINI_API_KEY=
DEFAULT_OPENAI_API_KEY=

# --- Frontend PWA ---
NEXT_PUBLIC_API_URL=http://localhost:8080
