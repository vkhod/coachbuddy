# Coach Buddy configuration. Copy to .env and fill in every value; nothing has a default.
# Generate each secret separately with:   openssl rand -hex 32
# Use hex values for the passwords: they are placed inside connection URLs unescaped.

# --- Gateway secrets ---
JWT_SECRET=
# 64 hex characters (32 bytes). Changing it makes all stored API keys unreadable.
MASTER_ENCRYPTION_KEY_HEX=
# Shared by gateway-go and agents-python.
INTERNAL_GATEWAY_TOKEN=

# --- Database passwords ---
POSTGRES_PASSWORD=
MONGO_PASSWORD=
REDIS_PASSWORD=

# --- Optional: server-side LLM key used when a coach has not saved their own ---
DEFAULT_GEMINI_API_KEY=
DEFAULT_OPENAI_API_KEY=

# --- URLs (local development values) ---
PUBLIC_SHARE_BASE_URL=http://localhost:3000/s
NEXT_PUBLIC_API_URL=http://localhost:8080
